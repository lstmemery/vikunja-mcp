__pycache__/
*.pyc
.venv/
dist/
.pytest_cache/
.ruff_cache/
.superpowers/
.vikunja-mcp.env

# Claude Code local state — keep shared config (settings.json) trackable.
# Use `.claude/*`, NOT `.claude/`: git won't descend into a blanket-ignored
# dir, so a later `!.claude/settings.json` could never re-include it. This
# hides machine-local runtime state (scheduled_tasks.lock, worktrees/,
# mailbox/, settings.local.json) while keeping shared project config.
.claude/*
!.claude/settings.json

# Stray saved web pages (e.g. docroot.html); no .html is tracked or ever has been.
*.html

# Playwright storage state = LIVE session cookies + localStorage, i.e. a credential for
# whatever the browser was logged into. This repo is PUBLIC, so it must never be commitable.
# Measured (#585): the only thing that can produce one is the `browser_storage_state` tool,
# and it REFUSES any path outside the MCP client's workspace root ("File access denied: …
# is outside allowed roots") — so it can only ever write INTO this repo, and with no
# filename given it writes `storage-state-<timestamp>.json` at the root. Nothing here sets
# PLAYWRIGHT_MCP_STORAGE_STATE; a machine-local opt-in keeps its file outside the repo.
*storage-state*.json
*storage_state*.json
